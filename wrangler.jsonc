{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fadec",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Teaching data lives in D1. `database_id` is a local placeholder: run
  // `wrangler d1 create fadec-teacher` and paste the real id before deploying,
  // or provision the binding through Sites. Local development uses the state
  // under .wrangler/ and never touches the remote database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fadec-teacher",
      "database_id": "8f3f9b1e-6a2c-4a8e-9c2a-5c1f7d4b2e11"
    }
  ]
}
